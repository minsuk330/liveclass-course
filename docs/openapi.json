{
  "openapi": "3.1.0",
  "info": {
    "title": "LiveClass-BE-A"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "local"
    }
  ],
  "tags": [
    {
      "name": "강의",
      "description": "강의 관련 API"
    },
    {
      "name": "[회원]대기열",
      "description": "강의 대기열 등록/이탈 API"
    },
    {
      "name": "[회원]수강 신청",
      "description": "수강 신청 관련 API"
    },
    {
      "name": "[회원]결제",
      "description": "결제 처리 API (NICE PG mock)"
    }
  ],
  "paths": {
    "/api/v1/payments/{paymentId}/confirm": {
      "post": {
        "tags": [
          "[회원]결제"
        ],
        "summary": "결제 승인 확정 (Confirm)",
        "description": "서버가 Mock PG에 승인 요청을 보내고, 성공 시 Payment PAID + Enrollment CONFIRMED 전환.",
        "operationId": "confirm",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmPaymentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/callback": {
      "post": {
        "tags": [
          "[회원]결제"
        ],
        "summary": "PG Callback (Webhook 모사)",
        "description": "PG에서 서버로 결제 결과를 통보합니다. SUCCESS면 IN_PROGRESS, FAIL이면 FAILED 전환.",
        "operationId": "callback",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCallbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/enrollments": {
      "post": {
        "tags": [
          "[회원]수강 신청"
        ],
        "summary": "수강 신청",
        "description": "OPEN 상태인 강의에 PENDING 상태로 신청합니다. 비관적 락으로 정원 초과 방지.",
        "operationId": "create",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEnrollmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/enrollments/{enrollmentId}/payments": {
      "post": {
        "tags": [
          "[회원]결제"
        ],
        "summary": "결제 요청 (Ready)",
        "description": "Enrollment PENDING 상태에서 결제를 시작합니다. Mock PG에 결제창 요청 후 paymentUrl을 반환합니다.",
        "operationId": "initiate",
        "parameters": [
          {
            "name": "enrollmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/InitiatePaymentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/classes": {
      "get": {
        "tags": [
          "강의"
        ],
        "summary": "강의 목록 조회",
        "description": "강의 목록 조회이며 상태로 필터 가능합니다.",
        "operationId": "search",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "DRAFT",
                "OPEN",
                "CLOSED"
              ]
            }
          },
          {
            "name": "creatorId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "classSortType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "UPDATED",
                "CREATED",
                "PRICE",
                "START_DATE",
                "END_DATE",
                "TITLE"
              ]
            }
          },
          {
            "name": "sortDirection",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "페이지 번호 (0부터 시작)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "description": "페이지 번호 (0부터 시작)",
              "example": 0
            },
            "example": 0
          },
          {
            "name": "size",
            "in": "query",
            "description": "페이지 크기 (최대 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10,
              "description": "페이지 크기 (최대 100)",
              "example": 10
            },
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseClassListItemResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "강의"
        ],
        "summary": "강의 등록",
        "description": "제목, 설명, 가격, 정원(최대 수강 인원), 수강 기간(시작일~종료일)을 입력해 강의를 등록합니다.",
        "operationId": "create_1",
        "parameters": [
          {
            "name": "creatorId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClassRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ClassResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/classes/{classId}/waitlist": {
      "post": {
        "tags": [
          "[회원]대기열"
        ],
        "summary": "대기열 등록",
        "description": "정원이 찬 OPEN 강의에 대기열 등록. FIFO 순번 자동 할당. 비관적 락으로 position 충돌 방지.",
        "operationId": "register",
        "parameters": [
          {
            "name": "classId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/WaitlistResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/classes/{classId}/status": {
      "patch": {
        "tags": [
          "강의"
        ],
        "summary": "강의 상태 전환",
        "description": "DRAFT → OPEN → CLOSED 순서만 허용. 본인이 개설한 강의만 전환 가능.",
        "operationId": "changeStatus",
        "parameters": [
          {
            "name": "classId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "creatorId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeClassStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
