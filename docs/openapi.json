    "/api/v1/classes/{classId}": {
      "get": {
        "tags": [
          "강의"
        ],
        "summary": "강의 상세 조회",
        "description": "강의에 대한 상세조회 입니다(현재 신청 인원 포함).",
        "operationId": "get",
        "parameters": [
          {
            "name": "classId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ClassResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "강의"
        ],
        "summary": "강의 삭제",
        "description": "강의를 soft delete 합니다. 활성 신청(PENDING/CONFIRMED)이 있으면 차단됩니다. 대기열은 cascade soft delete.",
        "operationId": "delete",
        "parameters": [
          {
            "name": "classId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
