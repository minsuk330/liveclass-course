  "components": {
    "schemas": {
      "ConfirmPaymentResponse": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "READY",
              "IN_PROGRESS",
              "PAID",
              "FAILED",
              "CANCELLED"
            ]
          },
          "amount": {
            "type": "number"
          },
          "approvedAt": {
            "type": "string",
            "format": "date-time"
          },
          "success": {
            "type": "boolean"
          },
          "failedReason": {
            "type": "string"
          }
        }
      },
      "PaymentCallbackRequest": {
        "type": "object",
        "properties": {
          "tid": {
            "type": "string",
            "description": "PG 거래 ID",
            "example": "nicepay_abc123",
            "minLength": 1
          },
          "authToken": {
            "type": "string",
            "description": "PG 인증 토큰",
            "example": "auth_xyz",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "description": "PG 결제 결과",
            "enum": [
              "SUCCESS",
              "FAIL"
            ],
            "example": "SUCCESS"
          },
          "failReason": {
            "type": "string",
            "description": "실패 사유 (status=FAIL일 때)",
            "example": "카드 한도 초과"
          }
        },
        "required": [
          "authToken",
          "status",
          "tid"
        ]
      },
      "CreateEnrollmentRequest": {
        "type": "object",
        "properties": {
          "classId": {
            "type": "integer",
            "format": "int64",
            "description": "수강 신청할 강의 ID",
            "example": 101
          }
        },
        "required": [
          "classId"
        ]
      },
      "EnrollmentResponse": {
        "type": "object",
        "properties": {
          "enrollmentId": {
            "type": "integer",
            "format": "int64"
          },
          "classId": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "CANCELLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": "string",
